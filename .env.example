NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional shared Redis URL; leave empty to use in-memory rate limiting or Upstash REST below.
REDIS_URL=
# Optional Upstash REST URL; leave empty when REDIS_URL or in-memory rate limiting is used.
UPSTASH_REDIS_REST_URL=
# Optional Upstash REST token; leave empty when REDIS_URL or in-memory rate limiting is used.
UPSTASH_REDIS_REST_TOKEN=
# Optional Turnstile public site key; leave empty to disable the CAPTCHA widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional Turnstile secret key; leave empty only when CAPTCHA verification is not configured.
TURNSTILE_SECRET_KEY=
# Optional iframe embedding toggle; leave empty or false, and keep false in production.
ALLOW_IFRAME_EMBED=false
# Optional client iframe embedding toggle; leave empty or false, and keep false in production.
NEXT_PUBLIC_ALLOW_IFRAME_EMBED=false
# Optional mock-session signing secret for local development only; leave empty in production.
MOCK_SESSION_SECRET=